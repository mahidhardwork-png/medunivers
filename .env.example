# MedUniverse Infrastructure Platform
# Environment Configuration

# Database
DATABASE_URL="postgresql://meduniverse:dev_password_123@localhost:5432/meduniverse_dev"

# JWT Authentication
JWT_SECRET="your-super-secret-jwt-key-change-in-production-12345"
JWT_EXPIRY="7d"

# OAuth Configuration
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# AWS S3 Configuration
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="minioadmin"
AWS_SECRET_ACCESS_KEY="minioadmin123"
AWS_S3_BUCKET="meduniverse-dev"
AWS_S3_ENDPOINT="http://localhost:9000"

# WebSocket Configuration
WEBSOCKET_PORT=3001
WEBSOCKET_CORS_ORIGIN="http://localhost:3000"

# Email Service
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@meduniverse.com"

# Redis Configuration
REDIS_URL="redis://localhost:6379"

# Application
APP_ENV="development"
APP_NAME="MedUniverse"
APP_URL="http://localhost:3001"
FRONTEND_URL="http://localhost:3000"

# Logging
LOG_LEVEL="debug"

# Payment Gateway
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
STRIPE_SECRET_KEY=""

# AI Services
OPENAI_API_KEY=""

# Healthcare Compliance
HIPAA_ENABLED=true
ENCRYPTION_KEY="your-encryption-key-change-in-production"

# Server
NODE_ENV="development"
PORT=3001
